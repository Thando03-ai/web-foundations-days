CREATE TABLE users (
 id INT PRIMARY KEY,
 email VARCHAR(255),
 password_hash VARCHAR(255)
);

CREATE TABLE notes (
 id INT PRIMARY KEY,
 user_id INT,
 title VARCHAR(100),
 body TEXT,
 FOREIGN KEY(user_id) REFERENCES users(id)
);

CREATE TABLE tags (
 id INT PRIMARY KEY,
 name VARCHAR(50)
);

CREATE TABLE note_tags (
 note_id INT,
 tag_id INT,
 PRIMARY KEY(note_id, tag_id),
 FOREIGN KEY(note_id) REFERENCES notes(id),
 FOREIGN KEY(tag_id) REFERENCES tags(id)
);

Example Queries
SQL
SELECT * FROM notes;
SQL
SELECT * FROM notes
WHERE user_id = 1;
SQL
SELECT n.title, t.name
FROM notes n
JOIN note_tags nt
ON n.id = nt.note_id
JOIN tags t
ON t.id = nt.tag_id;
Index
SQL
CREATE INDEX idx_notes_user_id
ON notes(user_id);

Reason:

Improves performance when retrieving a user's notes.

SQL vs NoSQL

SQL is chosen because QuickNotes has structured data, relationships between entities, and benefits from transactions and referential integrity.

